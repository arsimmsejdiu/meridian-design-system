[
  {
    "name": "tokens CSS",
    "path": "packages/tokens/dist/tokens.css",
    "gzip": true,
    "limit": "3 kB"
  },
  {
    "name": "one component, standalone (mrd-button + inlined runtime)",
    "path": "packages/components/dist/components/mrd-button.js",
    "limit": "25 kB"
  },
  {
    "name": "text field, standalone",
    "path": "packages/components/dist/components/mrd-text-field.js",
    "limit": "25 kB"
  },
  {
    "name": "react \u2014 form adapters, excluding peers",
    "path": "packages/react/dist/index.js",
    "import": "{ MeridianForm, FormTextField }",
    "ignore": ["react", "react-dom", "react-hook-form", "zod", "@hookform/resolvers"],
    "limit": "4 kB"
  },
  {
    "name": "react \u2014 useTheme alone (tree-shaking check)",
    "path": "packages/react/dist/index.js",
    "import": "{ useTheme }",
    "ignore": ["react"],
    "limit": "1 kB"
  }
]
