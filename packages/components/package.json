{
  "name": "@meridian/components",
  "version": "0.1.0",
  "description": "Framework-agnostic Web Components built with Stencil.",
  "license": "Apache-2.0",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "unpkg": "dist/meridian/meridian.esm.js",
  "customElements": "dist/custom-elements/index.js",
  "files": [
    "dist/",
    "loader/",
    "hydrate/",
    "custom-elements-types.d.ts",
    "custom-elements.json"
  ],
  "scripts": {
    "build": "stencil build --docs",
    "dev": "stencil build --dev --watch --serve",
    "test": "stencil test --spec",
    "test:e2e": "stencil test --e2e",
    "test:a11y": "stencil test --e2e",
    "test:watch": "stencil test --spec --watchAll",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@stencil/core": "^4.22.1"
  },
  "devDependencies": {
    "@stencil/angular-output-target": "^1.5.0",
    "@stencil/react-output-target": "^1.6.2",
    "@stencil/sass": "^3.0.12",
    "@types/jest": "^29.5.14",
    "@meridian/tokens": "workspace:*",
    "axe-core": "^4.10.2",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "puppeteer": "^23.6.0",
    "typescript": "^5.6.3"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./components": {
      "types": "./custom-elements-types.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/components": {
      "types": "./custom-elements-types.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/components/*": "./dist/components/*",
    "./hydrate": {
      "types": "./hydrate/index.d.ts",
      "import": "./hydrate/index.js",
      "require": "./hydrate/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./dist/*": "./dist/*",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  }
}
